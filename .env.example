# NetLinks prototype environment variables.
# docker-compose.yml already sets sensible local defaults; copy to .env only to override.
# Never commit a real .env (it is gitignored).

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://netlinks:netlinks@db:5432/netlinks
# Separate database used by integration tests (created by db/init/01-test-db.sql)
TEST_DATABASE_URL=postgresql+psycopg://netlinks:netlinks@db:5432/netlinks_test

# --- Local paths inside the backend container ---
AI_CACHE_DIR=/ai-cache
DEMO_ASSETS_DIR=/demo-assets
UPLOAD_DIR=/data/uploads

# --- API ---
CORS_ORIGINS=http://localhost:3000

# --- Amazon Bedrock (Live AI mode only; Cached mode needs none of this) ---
# Production target region is af-south-1 (Cape Town). Confirm model availability there
# before live pilots; a cross-Region inference profile ID may be needed for Claude.
BEDROCK_REGION=af-south-1
# Placeholder: set to a Claude model ID or inference profile ID available to your account
BEDROCK_EXTRACTION_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# AWS credentials passthrough (empty by default; leave empty for the cached demo)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- Document storage ---
# local (default, uploads volume) or s3 (production target: private, encrypted bucket in af-south-1)
STORAGE_BACKEND=local
S3_BUCKET=

# Production target (configuration only, NOT deployed by this repo):
# AWS af-south-1 - ECS Fargate (backend/frontend), RDS PostgreSQL with pgvector, S3 for documents,
# Bedrock for extraction and embeddings, Cognito for authentication.
